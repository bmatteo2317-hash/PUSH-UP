# Copia in .env locale per `vercel dev` (NON committare il valore reale).
# Su Vercel: Project Settings → Environment Variables → aggiungi DATABASE_URL
# Prendila da Neon Dashboard → Connect → Connection string (pooled consigliato per serverless)
DATABASE_URL="postgresql://user:password@ep-xxx.neon.tech/dbname?sslmode=require"

# Opzionale: se vuoi separare migrate/seed con connection diretta (non-pooled)
# DIRECT_URL="postgresql://user:password@ep-xxx.neon.tech/dbname?sslmode=require"
